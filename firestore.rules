rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened primitive helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Transaction validator
    function isValidTransaction(data, userId) {
      return data.userId == request.auth.uid
        && data.userId == userId
        && data.type in ['income', 'expense']
        && data.amount is number
        && data.amount > 0
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 64
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('description' in data) || (data.description is string && data.description.size() <= 200))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && data.keys().hasAll(['userId', 'type', 'amount', 'category', 'date'])
        && data.keys().hasOnly(['id', 'userId', 'type', 'amount', 'category', 'description', 'date', 'paymentMethod', 'createdAt', 'updatedAt']);
    }

    // Budget validator
    function isValidBudget(data, userId) {
      return data.userId == request.auth.uid
        && data.userId == userId
        && data.month is string
        && data.month.size() == 7
        && data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && data.monthlyBudget is number
        && data.monthlyBudget >= 0
        && (!('savingsGoal' in data) || (data.savingsGoal is number && data.savingsGoal >= 0))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('id' in data) || (data.id is string && data.id.size() <= 64))
        && data.keys().hasAll(['userId', 'month', 'monthlyBudget'])
        && data.keys().hasOnly(['id', 'userId', 'month', 'monthlyBudget', 'savingsGoal', 'updatedAt']);
    }

    // User Profile validator
    function isValidProfile(data, userId) {
      return data.userId == request.auth.uid
        && data.userId == userId
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && data.keys().hasAll(['userId'])
        && data.keys().hasOnly(['userId', 'displayName', 'currency', 'updatedAt']);
    }

    // User Scope
    match /users/{userId} {
      allow get: if isOwner(userId);

      // User Profile subcollection
      match /profile/{profileId} {
        allow get: if isOwner(userId) && isValidId(profileId);
        allow create: if isOwner(userId) && isValidId(profileId) && isValidProfile(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(profileId) && isValidProfile(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currency', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(profileId);
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'description', 'date', 'paymentMethod', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Monthly Budgets subcollection
      match /budgets/{budgetId} {
        allow get: if isOwner(userId) && isValidId(budgetId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(budgetId) && isValidBudget(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(budgetId) && isValidBudget(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().month == existing().month
          && incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'savingsGoal', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(budgetId);
      }
    }
  }
}
